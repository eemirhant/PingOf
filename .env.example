# --- Yerel PostgreSQL (Windows varsayilan kurulum) ---
DATABASE_URL="postgresql://postgres:SIFRENIZ@localhost:5432/pingof?schema=public"

# Auth.js — setup-db.bat otomatik uretir; elle kuruyorsaniz:
# PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256})-as[byte[]])
AUTH_SECRET="your-auth-secret-here"

# Application URL (Auth.js)
AUTH_URL="http://localhost:3000"

# Optional: email provider for password reset (Resend)
# Without RESEND_API_KEY, reset links are printed to the server console.
# RESEND_API_KEY=""
# EMAIL_FROM="PingOf <noreply@example.com>"
