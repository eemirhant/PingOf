# --- Yerel PostgreSQL (Windows varsayilan kurulum) ---
DATABASE_URL="postgresql://postgres:SIFRENIZ@localhost:5432/pingof?schema=public"

# Auth.js — setup-db.bat otomatik uretir; elle kuruyorsaniz:
# PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256})-as[byte[]])
AUTH_SECRET="your-auth-secret-here"

# Application URL (Auth.js + absolute links)
# Local: leave AUTH_URL unset and set AUTH_TRUST_HOST so request Host is used.
AUTH_TRUST_HOST="true"
# AUTH_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ENVIRONMENT="development"

# Staging / production / Vercel Preview: set to the public https URL
# AUTH_URL="https://your-app.vercel.app"
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
# NEXT_PUBLIC_ENVIRONMENT="production"

# Optional: email provider for password reset (Resend)
# Without RESEND_API_KEY, reset links are printed to the server console.
# RESEND_API_KEY=""
# EMAIL_FROM="PingOf <noreply@example.com>"

# --- Firebase Cloud Messaging (Web Push) ---
# Firebase Console → Project settings → Your apps → Web app
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""
# Web Push certificates (Cloud Messaging → Web Push certificates) → Key pair
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
# Service account (Project settings → Service accounts → Generate new private key)
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: register offline shell SW during `next dev` when FCM is off
# NEXT_PUBLIC_ENABLE_SW="true"

# --- Vercel Blob (avatar / logo uploads) ---
# Required on Vercel — local public/uploads is ephemeral in serverless.
# Vercel Dashboard → Storage → Blob → Connect → copy token
# BLOB_READ_WRITE_TOKEN=""
