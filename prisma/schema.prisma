generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums (PRD Bölüm 5 + .cursorrules) ---

enum UserRole {
  OWNER
  MEMBER
}

enum MatchFormat {
  SINGLES
  DOUBLES
}

enum MatchStatus {
  PLANNED
  PENDING
  COMPLETED
  CANCELLED
}

enum TournamentType {
  KNOCKOUT
  ROUND_ROBIN
}

enum TournamentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// --- Models (PRD Bölüm 5) ---

model Organization {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  /// Set immediately after the owner user is created during registration.
  ownerId    String?
  /// Optional brand logo shown next to PingOf in the app header (OWNER uploads).
  logoUrl    String?
  createdAt  DateTime @default(now())

  owner       User?        @relation("OrganizationOwner", fields: [ownerId], references: [id])
  users       User[]       @relation("OrganizationMembers")
  matches     Match[]
  tournaments Tournament[]
  challenges  Challenge[]
  realtimeEvents OrgRealtimeEvent[]

  @@index([ownerId])
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  passwordHash   String
  fullName       String
  avatarUrl      String?
  role           UserRole
  createdAt      DateTime @default(now())

  organization       Organization   @relation("OrganizationMembers", fields: [organizationId], references: [id], onDelete: Cascade)
  ownedOrganizations Organization[] @relation("OrganizationOwner")

  createdMatches           Match[]                 @relation("MatchCreatedBy")
  resultEnteredMatches     Match[]                 @relation("MatchResultEnteredBy")
  matchParticipations      MatchParticipant[]
  tournamentParticipations TournamentParticipant[]
  createdTournaments       Tournament[]            @relation("TournamentCreatedBy")
  challengesSent           Challenge[]             @relation("ChallengeFrom")
  challengesReceived       Challenge[]             @relation("ChallengeTo")
  notifications            Notification[]
  passwordResetTokens      PasswordResetToken[]
  notificationSettings     UserNotificationSettings?

  @@index([organizationId])
}

/// Web Push subscriptions removed — push delivery is via OneSignal (external_id = user.id).

/// Single-use, time-limited password reset tokens (US-3 / KK-3)
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 hash of the raw token sent in the email link
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Match {
  id                String      @id @default(cuid())
  organizationId    String
  format            MatchFormat
  status            MatchStatus
  scheduledAt       DateTime?
  playedAt          DateTime?
  createdById       String
  resultEnteredById String?
  tournamentId      String?
  tournamentRound   Int?
  bracketSlot       Int?
  stakeNote         String?
  /// When stakeNote is set and match is COMPLETED: false = unpaid, true = paid (US-16).
  stakeSettled      Boolean     @default(false)
  team1SetsWon      Int?
  team2SetsWon      Int?
  winnerTeam        Int?
  /// Optional display name for team 1 (2v2 only). Visual only — stats use players.
  team1Name         String?
  /// Optional display name for team 2 (2v2 only). Visual only — stats use players.
  team2Name         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User               @relation("MatchCreatedBy", fields: [createdById], references: [id])
  resultEnteredBy User?              @relation("MatchResultEnteredBy", fields: [resultEnteredById], references: [id])
  tournament      Tournament?        @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  participants    MatchParticipant[]
  sets            MatchSet[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([tournamentId])
  @@index([createdById])
}

model MatchParticipant {
  id      String @id @default(cuid())
  matchId String
  userId  String
  team    Int

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId])
}

model MatchSet {
  id         String @id @default(cuid())
  matchId    String
  setNumber  Int
  team1Score Int
  team2Score Int

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, setNumber])
}

model Tournament {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  type           TournamentType
  format         MatchFormat
  status         TournamentStatus
  createdById    String
  startsAt       DateTime

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                    @relation("TournamentCreatedBy", fields: [createdById], references: [id])
  participants TournamentParticipant[]
  matches      Match[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model TournamentParticipant {
  id           String @id @default(cuid())
  tournamentId String
  userId       String
  seed         Int    @default(0)
  /// Same pairIndex = same doubles team; null for singles.
  pairIndex    Int?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([userId])
  @@index([tournamentId, seed])
}

model Challenge {
  id             String          @id @default(cuid())
  organizationId String
  fromUserId     String
  toUserId       String
  proposedAt     DateTime?
  note           String?
  status         ChallengeStatus
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromUser     User         @relation("ChallengeFrom", fields: [fromUserId], references: [id])
  toUser       User         @relation("ChallengeTo", fields: [toUserId], references: [id])

  @@index([organizationId])
  @@index([toUserId, status])
  @@index([fromUserId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

/// Per-user notification channel preferences + quiet hours (DND).
model UserNotificationSettings {
  userId      String   @id
  /// Partial map of managed NotificationType → { inApp, push }; merged with defaults at read time.
  preferences Json     @default("{}")
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Short-lived org-scoped events for realtime polling (TTL ~1h on write).
model OrgRealtimeEvent {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  entityId       String?
  actorUserId    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}
